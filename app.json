{
  "expo": {
    "name": "Mi Libretita",
    "slug": "mi-libretita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kevin.milibretita",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3cf009d7-80af-42d8-ba6b-4bdbd814378c"
      }
    }
  }
}
